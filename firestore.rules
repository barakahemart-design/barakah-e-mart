rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function signedInEmail() {
      return signedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : "";
    }

    function owns(data) {
      return signedIn() && (
        (data.keys().hasAny(['user_id']) && data.user_id == request.auth.uid) ||
        (data.keys().hasAny(['userId']) && data.userId == request.auth.uid) ||
        (data.keys().hasAny(['owner_id']) && data.owner_id == request.auth.uid) ||
        (signedInEmail() != "" && (
          (data.keys().hasAny(['store_id']) && data.store_id == signedInEmail()) ||
          (data.keys().hasAny(['storeId']) && data.storeId == signedInEmail()) ||
          (data.keys().hasAny(['email']) && data.email == signedInEmail()) ||
          (data.keys().hasAny(['linked_email']) && data.linked_email == signedInEmail()) ||
          (data.keys().hasAny(['linkedEmail']) && data.linkedEmail == signedInEmail())
        ))
      );
    }

    function ownsIncoming() {
      return owns(request.resource.data);
    }

    // Primary POS collections: users may only access records belonging to
    // their authenticated UID or their authenticated Firebase account email.
    match /{collectionName}/{documentId} {
      allow read: if collectionName in [
        'products', 'customers', 'expenses', 'transactions',
        'transaction_items', 'purchases', 'business_info'
      ] && owns(resource.data);
      allow create: if collectionName in [
        'products', 'customers', 'expenses', 'transactions',
        'transaction_items', 'purchases', 'business_info'
      ] && ownsIncoming();
      allow update: if collectionName in [
        'products', 'customers', 'expenses', 'transactions',
        'transaction_items', 'purchases', 'business_info'
      ] && owns(resource.data) && ownsIncoming();
      allow delete: if collectionName in [
        'products', 'customers', 'expenses', 'transactions',
        'transaction_items', 'purchases', 'business_info'
      ] && owns(resource.data);
    }

    match /profiles/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        (resource.data.keys().hasAny(['email']) &&
          resource.data.email == signedInEmail())
      );
      allow create: if signedIn() && (
        request.auth.uid == userId ||
        (request.resource.data.keys().hasAny(['email']) &&
          request.resource.data.email == signedInEmail())
      );
      allow update: if signedIn() && (
        request.auth.uid == userId ||
        (resource.data.keys().hasAny(['email']) &&
          resource.data.email == signedInEmail())
      ) && (
        request.auth.uid == userId ||
        (request.resource.data.keys().hasAny(['email']) &&
          request.resource.data.email == signedInEmail())
      );
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /passcode_syncs/{syncId} {
      allow read: if owns(resource.data);
      allow create: if ownsIncoming();
      allow update: if owns(resource.data) && ownsIncoming();
      allow delete: if owns(resource.data);
    }

    match /deleted_records/{recordId} {
      allow read: if owns(resource.data);
      allow create: if ownsIncoming();
      allow update: if owns(resource.data) && ownsIncoming();
      allow delete: if false;
    }

    match /store_auth_credentials/{credentialId} {
      allow read: if signedIn() && resource.data.store_id == signedInEmail();
      allow create: if signedIn() && request.resource.data.store_id == signedInEmail();
      allow update: if signedIn() && resource.data.store_id == signedInEmail()
        && request.resource.data.store_id == signedInEmail();
      allow delete: if false;
    }

    // Deny all collections not explicitly covered above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}