rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function signedInEmail() {
      return signedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : "";
    }

    function owns(data) {
      let hasStoreIdentity = data.keys().hasAny([
        'store_id', 'storeId', 'email', 'linked_email', 'linkedEmail'
      ]);
      let hasUidIdentity = data.keys().hasAny([
        'user_id', 'userId', 'owner_id'
      ]);
      // Empty legacy email aliases are treated as unset. Non-empty aliases
      // must all match the authenticated Firebase email (case-insensitive).
      // This keeps UID-owned legacy records usable without allowing a stale,
      // conflicting store email to fall back to UID ownership.
      let storeMatches = signedInEmail() != ""
        && (!data.keys().hasAny(['store_id']) || (data.store_id is string && (data.store_id == "" || data.store_id.lower() == signedInEmail())))
        && (!data.keys().hasAny(['storeId']) || (data.storeId is string && (data.storeId == "" || data.storeId.lower() == signedInEmail())))
        && (!data.keys().hasAny(['email']) || (data.email is string && (data.email == "" || data.email.lower() == signedInEmail())))
        && (!data.keys().hasAny(['linked_email']) || (data.linked_email is string && (data.linked_email == "" || data.linked_email.lower() == signedInEmail())))
        && (!data.keys().hasAny(['linkedEmail']) || (data.linkedEmail is string && (data.linkedEmail == "" || data.linkedEmail.lower() == signedInEmail())));
      let uidMatches = (!data.keys().hasAny(['user_id']) || data.user_id == request.auth.uid)
        && (!data.keys().hasAny(['userId']) || data.userId == request.auth.uid)
        && (!data.keys().hasAny(['owner_id']) || data.owner_id == request.auth.uid);

      // Store email is authoritative when present. This prevents a stale or
      // conflicting UID field from granting another account access to the record.
      return signedIn() && (
        (hasStoreIdentity && storeMatches) ||
        (!hasStoreIdentity && hasUidIdentity && uidMatches)
      );
    }

    function ownsIncoming() {
      return owns(request.resource.data);
    }

    // Primary POS collections: users may only access records belonging to
    // their authenticated UID or their authenticated Firebase account email.
    match /{collectionName}/{documentId} {
      allow read: if collectionName in [
        'products', 'customers', 'expenses', 'transactions',
        'transaction_items', 'purchases', 'business_info'
      ] && owns(resource.data);
      allow create: if collectionName in [
        'products', 'customers', 'expenses', 'transactions',
        'transaction_items', 'purchases', 'business_info'
      ] && ownsIncoming();
      allow update: if collectionName in [
        'products', 'customers', 'expenses', 'transactions',
        'transaction_items', 'purchases', 'business_info'
      ] && owns(resource.data) && ownsIncoming();
      allow delete: if collectionName in [
        'products', 'customers', 'expenses', 'transactions',
        'transaction_items', 'purchases', 'business_info'
      ] && owns(resource.data);
    }

    match /profiles/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        (resource.data.keys().hasAny(['email']) &&
          resource.data.email == signedInEmail())
      );
      allow create: if signedIn() && (
        request.auth.uid == userId ||
        (request.resource.data.keys().hasAny(['email']) &&
          request.resource.data.email == signedInEmail())
      );
      allow update: if signedIn() && (
        request.auth.uid == userId ||
        (resource.data.keys().hasAny(['email']) &&
          resource.data.email == signedInEmail())
      ) && (
        request.auth.uid == userId ||
        (request.resource.data.keys().hasAny(['email']) &&
          request.resource.data.email == signedInEmail())
      );
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /passcode_syncs/{syncId} {
      allow read: if owns(resource.data);
      allow create: if ownsIncoming();
      allow update: if owns(resource.data) && ownsIncoming();
      allow delete: if owns(resource.data);
    }

    match /deleted_records/{recordId} {
      allow read: if owns(resource.data);
      allow create: if ownsIncoming();
      allow update: if owns(resource.data) && ownsIncoming();
      allow delete: if false;
    }

    // PIN hashes are server-only. The Admin SDK bypasses client rules;
    // browser clients must never be able to read or alter credential hashes.
    match /store_auth_credentials/{credentialId} {
      allow read, write: if false;
    }

    // Deny all collections not explicitly covered above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}