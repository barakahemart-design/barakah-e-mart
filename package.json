{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "prebuild": "node scripts/apply-safe-sync-recovery.cjs && node scripts/final-data-guards.cjs && node scripts/firestore-quota-guard.cjs && node scripts/final-stability-fixes.cjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
